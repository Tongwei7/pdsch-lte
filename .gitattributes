* text=auto
.gitignore text eol=lf
.gitattributes text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
# MATLAB 源码保留原始换行字节，避免改变生成器摘要；仍可查看文本差异。
*.m -text
*.mat binary
*.zip binary
*.png binary
*.pdf binary
